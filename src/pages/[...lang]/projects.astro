---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '../../layouts/Layout.astro';
import { getLangPaths, useTranslations } from '../../i18n/utils';

export const getStaticPaths = getLangPaths;
const currentLang = Astro.currentLocale || "fr";
const t = useTranslations(Astro.currentLocale);
---
<Layout>
	<div class="container">
        <h2>{t('projects.intro')}</h2>
        <p>{t('projects.p1')}</p>
        <p>{t('projects.p2')}</p>
	</div>
    <div class="card-container">
        <article>
            <h3>Booksnap</h3>
            <p>{t('projects.booksnap')}</p>
            <a href={getRelativeLocaleUrl(currentLang, '/booksnap')} target="_blank" rel="external">{t('projects.cta')}</a>
        </article>
        <article>
            <h3>Skills</h3>
            <p set:html={t('projects.skills')} />
            <a href="https://github.com/SwannJulien/skills" target="_blank" rel="external">{t('projects.cta')}</a>
        </article>
        <article>
            <h3>Frontend Mentor</h3>
            <p>{t('projects.frontendMentor')}</p>
            <a href="https://github.com/SwannJulien/frontend-mentor-challenges" target="_blank" rel="external">{t('projects.cta')}</a>
        </article>
    </div>	
</Layout>

<style>
	.container {
		margin-top: 6rem;
		padding-bottom: 2rem;
		@media (min-width: 1024px) {
			margin-inline: auto;
			max-width: 60%;
		}
	}
    h2 {
        font-family: 'Nunito', sans-serif;
        font-size: var(--step-2);
        font-weight: 500;
        color: var(--color-tertiary);
    }
    p {
        font-family: 'Nunito', sans-serif;
        font-size: var(--step-1);
        color: var(--color-primary);
        line-height: 1.5;
        text-align: justify;
        margin-bottom: 0;
    }
    a {
        display: flex;
        justify-content: center;
        align-items: center;
        align-self: center;
        margin-top: auto;
        text-decoration: none;
        cursor: pointer;
        font-family: Nunito, sans-serif;
        font-size: var(--step-0);
        font-weight: 600;
        color: var(--color-accent);
    }
    a::before {
        content: '>>>';
        display: none;
        margin-right: 0.5rem;
        color: var(--color-accent);
    }
    a:hover:before {
        display: inline-block;
    }
    .card-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
        padding-bottom: 5rem;
    }
    article {
        display: flex;
        flex-direction: column;
        background-color: var(--color-secondary);
        border-radius: 0.5rem;
        padding: 1.5rem;
    }
    article h3 {
        font-family: 'Nunito', sans-serif;
        font-size: var(--step-2);
        font-weight: 600;
        color: var(--background-color);
        margin-bottom: 0.5rem;
        margin-top: .5rem;
    }
    article p {
        color: #404040;
    }
</style>