---
import Layout from '../../layouts/Layout.astro';
import { getLangPaths, useTranslations } from '../../i18n/utils';

export const getStaticPaths = getLangPaths;

const t = useTranslations(Astro.currentLocale);
---

<Layout>
	<div class="container">
		<h1 set:html={t('home.title')} />
		<p>{t('home.subtitle')}</p>
	</div>	
</Layout>

<style>
	.container {
		margin-top: 6rem; 
		
		@media (min-width: 768px) {
			margin-top: 8rem;
			max-width: 80%;
			margin-inline: auto;
		}
		@media (min-width: 1024px) {
			margin-top: 10rem;
			max-width: 65%;
		}
	}

	h1 {
		font-family: 'Lora', serif;
		font-size: var(--step-5);
		font-weight: 500;
	}

	p {
		margin-top: 2em;
		font-family: 'Nunito', sans-serif;
		font-size: var(--step-2);
		color: var(--color-primary);
	}

	/* :global because the span comes from set:html and is not scoped */
	h1 :global(span) {
		color: var(--color-accent);
	}
</style>
