---
import Layout from '../../layouts/Layout.astro';
import { getLangPaths, useTranslations } from '../../i18n/utils';

export const getStaticPaths = getLangPaths;

const t = useTranslations(Astro.currentLocale);

const paragraphs = ['about.p1', 'about.p2', 'about.p3', 'about.p4', 'about.p5', 'about.p6', 'about.p7', 'about.p8'] as const;
---

<Layout>
	<div class="container">
		<h1>{t('nav.about')}</h1>
		{paragraphs.map((key) => <p set:html={t(key)} />)}
	</div>	
</Layout>

<style>
	.container {
		margin-top: 6rem;
		padding-bottom: 2rem;
		@media (min-width: 1024px) {
			margin-inline: auto;
			max-width: 60%;
		}
	}
	h1 {
		font-family: 'Nunito', sans-serif;
		font-size: var(--step-3);
		font-weight: 500;
	}

	p {
		font-family: 'Nunito', sans-serif;
		font-size: var(--step-1);
		color: var(--color-primary);
		text-align: justify;
		max-width: 60ch;
	}
</style>