---
import Layout from '../layouts/Layout.astro';
---
<Layout>
	<div class="container">
		<h1>Projects</h1>
        <h2>Voici les projets personnels sur lesquels j'ai travaillé récemment.</h2>
        <p>Certains sont finis, d'autres sont en cours de développement et certains ne verront probablement pas le jour!</p>
        <p>Ce qui motive dans chacun de mes projets est à la fois de répondre à un besoin concret, de penser à l'expérience utilisateur et d'apprendre par la même occasion et de développer mes compétences.</p>
	</div>
    <div class="card-container">
        <div class="card">
            <h3>Booksnap</h3>
            <p>Application web de gestion de bibliothèque pour moyenes et grandes écoles</p>
        </div>
        <div class="card">
            <img src="/src/assets/destination_unknown.png" alt="Booksnap" />
            <div class="card-content">
                <h3>Project Title</h3>
                <p>Project description goes here.</p>
            </div>
        </div>
        <div class="card">
            <h3>Project Title</h3>
            <p>Project description goes here.</p>
        </div>
        <div class="card">
            <h3>Project Title</h3>
            <p>Project description goes here.</p>
        </div>
    </div>	
</Layout>

<style>
	.container {
		margin-top: 6rem;
		padding-bottom: 2rem;
		@media (min-width: 1024px) {
			margin-inline: auto;
			max-width: 60%;
		}
	}
    h1 {
		font-family: 'Nunito', sans-serif;
		font-size: var(--step-3);
		font-weight: 500;
	}
    h2 {
        font-family: 'Nunito', sans-serif;
        font-size: var(--step-2);
        font-weight: 500;
        color: var(--color-tertiary);
    }
    p {
        font-family: 'Nunito', sans-serif;
        font-size: var(--step-1);
        color: var(--color-primary);
        line-height: 1.5;
        text-align: justify;
    }
    .card-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }
    .card {
        background-color: var(--color-secondary);
        border-radius: 0.5rem;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }
    .card h3 {
        font-family: 'Nunito', sans-serif;
        font-size: var(--step-2);
        font-weight: 600;
        color: var(--background-color);
        margin-bottom: 0.5rem;
    }
    .card img {
        width: 100%;
        height: auto;
        margin-bottom: 1rem;
    }
    .card-content {
        padding: 1.5rem;
    }
</style>