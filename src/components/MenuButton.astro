---
import MenuScreen from './MenuScreen.astro';
---

<menu-button>
  <div class="hamburger-menu">
    <svg
      class="menu-icon" 
      xmlns="http://www.w3.org/2000/svg" 
      viewBox="0 0 24 24"
    >
      <path d="M3,18V16H21v2H3Zm0-5V11H21v2H3ZM3,8V6H21V8H3Z"/>
    </svg> 
  </div>
  
  <MenuScreen/>
</menu-button>

<script>
  // Define the behavior for our new type of HTML element.
  class MenuButton extends HTMLElement {
    connectedCallback() {

      const menuButton = this.querySelector("svg");
      const closeButton = this.querySelector(".close-button");
      const menuScreen = this.querySelector("menu-screen");
      const body = document.querySelector("body");

      if (menuButton === null || closeButton === null || menuScreen === null || body === null) {
        return;
      }

      const openMenu = () => {
        menuScreen.classList.add("is-open");
        body.classList.add("menu-open");
      };

      const closeMenu = () => {
        menuScreen.classList.remove("is-open");
        body.classList.remove("menu-open");
      };

      menuButton.addEventListener("click", openMenu);
      closeButton.addEventListener("click", closeMenu);

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 768) {
          closeMenu();
        }
      });
    }
  }

  customElements.define("menu-button", MenuButton);
</script>

<style>
 .menu-icon {
    width: 40px;
    color: var(--color-secondary);
    fill: currentColor;
    cursor: pointer;   
  }

  .hamburger-menu {
    @media (min-width: 768px) {
      display: none;
    }
  }
</style>