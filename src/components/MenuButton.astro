---
import ButtonJn from "./ButtonJn.astro";


---

<menu-button>
  <div class="menu-button-container">
    <svg
      class="menu-icon" 
      xmlns="http://www.w3.org/2000/svg" 
      viewBox="0 0 24 24"
    >
      <path d="M3,18V16H21v2H3Zm0-5V11H21v2H3ZM3,8V6H21V8H3Z"/>
    </svg> 
  </div>
  <!--<ButtonJn class="menu-button" text="Menu"/> -->
  <p hidden> X </p>
</menu-button>

<script>
  // Define the behavior for our new type of HTML element.
  class MenuButton extends HTMLElement {
    connectedCallback() {

      const menuButton = this.querySelector("svg");
      const paragraph = this.querySelector("p");

      if (menuButton === null || paragraph === null) {
        return;
      }

        menuButton.addEventListener("click", () => {
          const menuScreen = document.querySelector("menu-screen");
          const body = document.querySelector("body");

          if (menuScreen === null || body === null) {
            return;
          }

          menuScreen.toggleAttribute("hidden");
          body.classList.toggle("menu-open");
          menuButton.setAttribute("display", "none");
          paragraph.toggleAttribute("hidden");
        });

        paragraph.addEventListener("click", () => {
          const menuScreen = document.querySelector("menu-screen");
          const body = document.querySelector("body");

          if (menuScreen === null || body === null) {
            return;
          }

          menuScreen.toggleAttribute("hidden");
          body.classList.toggle("menu-open");
          menuButton.setAttribute("display", "block");
          paragraph.toggleAttribute("hidden");
        });
     
    }
  }

  customElements.define("menu-button", MenuButton);
</script>

<style>
  p {
    cursor: pointer;
    font-family: 'Nunito', sans-serif;
    font-size: var(--step-2);
    color: var(--color-secondary);
    margin: 0;
  }

 .menu-icon {
  width: 40px;
  color: var(--color-secondary);
  fill: currentColor;
  cursor: pointer;   
  }

  .menu-button-container:hover {
    background-color: var(--color-primary);
  }

</style>